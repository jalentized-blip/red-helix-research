{
  "name": "OrderCommunication",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "ID of the related order"
    },
    "order_number": {
      "type": "string",
      "description": "Order number for quick reference"
    },
    "customer_email": {
      "type": "string",
      "description": "Recipient email"
    },
    "customer_name": {
      "type": "string",
      "description": "Recipient name"
    },
    "subject": {
      "type": "string",
      "description": "Email subject"
    },
    "body": {
      "type": "string",
      "description": "Email body (HTML)"
    },
    "template_used": {
      "type": "string",
      "description": "Which template was used, if any"
    },
    "sent_by": {
      "type": "string",
      "description": "Admin email who sent it"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the email was sent"
    }
  },
  "required": [
    "order_id",
    "customer_email",
    "subject"
  ]
}