{
  "name": "UserPreference",
  "type": "object",
  "properties": {
    "favorite_products": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Array of product IDs marked as favorites"
    },
    "viewed_products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "viewed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": [],
      "description": "Recently viewed products with timestamps"
    },
    "preferred_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "User's most frequently accessed categories"
    },
    "search_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "searched_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": [],
      "description": "User's search queries with timestamps"
    }
  },
  "required": []
}